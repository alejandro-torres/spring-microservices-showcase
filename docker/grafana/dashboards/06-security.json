  "panels": [
    {"id":1,"type":"stat","title":"Failed logins (1 h)","description":"","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":0,"w":8,"h":5},"fieldConfig":{"defaults":{"unit":"none"},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(increase(showcase_auth_logins_total{result=\"failure\"}[1h]))"}]},
    {"id":2,"type":"stat","title":"Locked accounts (1 h)","description":"","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":8,"y":0,"w":8,"h":5},"fieldConfig":{"defaults":{"unit":"none"},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(increase(showcase_auth_accounts_locked_total[1h]))"}]},
    {"id":3,"type":"stat","title":"Rate limited requests (429, 1 h)","description":"","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":16,"y":0,"w":8,"h":5},"fieldConfig":{"defaults":{"unit":"none"},"overrides":[]},"options":{"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum(increase(http_server_requests_seconds_count{application=\"api-gateway\", status=\"429\"}[1h]))"}]},
    {"id":4,"type":"timeseries","title":"Gateway 401, 403 and 429 responses","description":"Invalid or revoked tokens, missing permissions and rate limiting.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":5,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (status) (rate(http_server_requests_seconds_count{application=\"api-gateway\", status=~\"401|403|429\"}[1m]))","legendFormat":"{{status}}","exemplar":true}]},
    {"id":5,"type":"timeseries","title":"Logins per minute","description":"A spike of failures can be a brute-force attack.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":5,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"none"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (result) (rate(showcase_auth_logins_total[1m])) * 60","legendFormat":"{{result}}","exemplar":true}]},
    {"id":6,"type":"logs","title":"auth-service security logs","description":"Logins, lockouts and revocations. Each line links to its trace in Zipkin.","datasource":{"type":"loki","uid":"loki"},"gridPos":{"x":0,"y":13,"w":24,"h":10},"fieldConfig":{"defaults":{"unit":""},"overrides":[]},"options":{"showTime":true,"wrapLogMessage":true,"enableLogDetails":true},"targets":[{"refId":"A","datasource":{"type":"loki","uid":"loki"},"expr":"{service=\"auth-service\"} |~ \"(?i)login|bloque|revoc|unlock|locked\""}]}
  ]
