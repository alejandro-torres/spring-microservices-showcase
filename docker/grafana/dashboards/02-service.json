{
  "uid": "showcase-service",
  "title": "2. By microservice",
  "description": "Slowest endpoints, errors by code, JVM, connection pool and circuit breakers of the chosen service.",
  "tags": ["showcase"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {"list": [{"name":"application","label":"Service","type":"query","datasource":{"type":"prometheus","uid":"prometheus"},"query":{"query":"label_values(http_server_requests_seconds_count, application)","refId":"apps"},"refresh":2,"current":{"text":"order-service","value":"order-service"}}]},
  "panels": [
    {"id":1,"type":"timeseries","title":"Slowest endpoints (p95)","description":"The 10 endpoints with the highest 95th percentile.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":0,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"topk(10, histogram_quantile(0.95, sum by (method, uri, le) (rate(http_server_requests_seconds_bucket{application=\"$application\", uri!~\"/actuator.*\"}[5m]))))","legendFormat":"{{method}} {{uri}}","exemplar":true}]},
    {"id":2,"type":"timeseries","title":"Errors by HTTP code","description":"4xx and 5xx responses by code.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":0,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (status) (rate(http_server_requests_seconds_count{application=\"$application\", status=~\"[45]..\"}[1m]))","legendFormat":"{{status}}","exemplar":true}]},
    {"id":3,"type":"timeseries","title":"JVM heap","description":"Heap memory used per replica.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":8,"w":8,"h":8},"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (instance) (jvm_memory_used_bytes{application=\"$application\", area=\"heap\"})","legendFormat":"{{instance}}","exemplar":true}]},
    {"id":4,"type":"timeseries","title":"GC pauses","description":"Time in collector pauses per second.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":8,"y":8,"w":8,"h":8},"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (instance) (rate(jvm_gc_pause_seconds_sum{application=\"$application\"}[1m]))","legendFormat":"{{instance}}","exemplar":true}]},
    {"id":5,"type":"timeseries","title":"Threads","description":"Live JVM threads.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":16,"y":8,"w":8,"h":8},"fieldConfig":{"defaults":{"unit":"none"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (instance) (jvm_threads_live_threads{application=\"$application\"})","legendFormat":"{{instance}}","exemplar":true}]},
    {"id":6,"type":"timeseries","title":"Connection pool (Hikari)","description":"Active PostgreSQL connections and requests waiting for one.","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":0,"y":16,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"none"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (instance) (hikaricp_connections_active{application=\"$application\"})","legendFormat":"activas {{instance}}","exemplar":true},{"refId":"B","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"sum by (instance) (hikaricp_connections_pending{application=\"$application\"})","legendFormat":"esperando {{instance}}","exemplar":true}]},
    {"id":7,"type":"timeseries","title":"Open circuit breakers","description":"1 = open (calls are cut off with 503).","datasource":{"type":"prometheus","uid":"prometheus"},"gridPos":{"x":12,"y":16,"w":12,"h":8},"fieldConfig":{"defaults":{"unit":"none"},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull","max"]},"tooltip":{"mode":"multi"}},"targets":[{"refId":"A","datasource":{"type":"prometheus","uid":"prometheus"},"expr":"max by (name) (resilience4j_circuitbreaker_state{application=\"$application\", state=\"open\"})","legendFormat":"{{name}}","exemplar":true}]}
  ]
}
