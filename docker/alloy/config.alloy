// Grafana Alloy: collects the logs of all docker compose containers and sends them to Loki.
// Each line carries the labels service (compose service) and container (the specific replica).

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=spring-microservices-showcase"]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.json.receiver]
}

// The microservices write JSON (ECS, with nested objects: {"log":{"level":...},"service":{...}}): the level is
// extracted as a label (to filter) and the traceId, spanId and replica as metadata (to find the logs
// of a trace and jump to Zipkin) without multiplying Loki's series.
loki.process "json" {
  stage.json {
    expressions = {
      level    = "log.level",
      traceId  = "traceId",
      spanId   = "spanId",
      instance = "service.node.name",
    }
  }
  stage.labels {
    values = { level = "" }
  }
  stage.structured_metadata {
    values = { traceId = "", spanId = "", instance = "" }
  }
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
