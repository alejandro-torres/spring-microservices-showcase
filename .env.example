# Copy this file as .env and change the passwords: docker compose reads it automatically.
# Without .env, docker-compose.yml uses development values that must not be used outside your machine.

# Spring profile: dev loads sample data and keeps 100 % of the traces; prod, JSON logs and 10 %.
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL: superuser and one user per service
POSTGRES_PASSWORD=cambia-esto
AUTH_DB_PASSWORD=cambia-esto
PRODUCT_DB_PASSWORD=cambia-esto
CUSTOMER_DB_PASSWORD=cambia-esto
ORDER_DB_PASSWORD=cambia-esto

# RabbitMQ: administrator (console at http://localhost:15672) and one user per service
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=cambia-esto
AUTH_RABBITMQ_PASSWORD=cambia-esto
PRODUCT_RABBITMQ_PASSWORD=cambia-esto
CUSTOMER_RABBITMQ_PASSWORD=cambia-esto
ORDER_RABBITMQ_PASSWORD=cambia-esto

# auth-service: secret of the internal-service OAuth2 client (client_credentials)
INTERNAL_CLIENT_SECRET=cambia-esto

# Browser origins that can call the API (CORS), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Replicas of the services under most load (horizontal scaling)
PRODUCT_SERVICE_REPLICAS=3
ORDER_SERVICE_REPLICAS=2

# Grafana (docker-compose.observability.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esto
