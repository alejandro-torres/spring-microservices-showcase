# Copia este fichero como .env y cambia las contraseñas: docker compose lo lee automáticamente.
# Sin .env, docker-compose.yml usa valores de desarrollo que no deben usarse fuera de tu máquina.

# Perfil de Spring: dev carga datos de ejemplo y guarda el 100 % de las trazas; prod, JSON en los logs y el 10 %.
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL: superusuario y un usuario por servicio
POSTGRES_PASSWORD=cambia-esto
AUTH_DB_PASSWORD=cambia-esto
PRODUCT_DB_PASSWORD=cambia-esto
CUSTOMER_DB_PASSWORD=cambia-esto
ORDER_DB_PASSWORD=cambia-esto

# RabbitMQ: administrador (consola en http://localhost:15672) y un usuario por servicio
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=cambia-esto
AUTH_RABBITMQ_PASSWORD=cambia-esto
PRODUCT_RABBITMQ_PASSWORD=cambia-esto
CUSTOMER_RABBITMQ_PASSWORD=cambia-esto
ORDER_RABBITMQ_PASSWORD=cambia-esto

# auth-service: secreto del cliente OAuth2 internal-service (client_credentials)
INTERNAL_CLIENT_SECRET=cambia-esto

# Orígenes del navegador que pueden llamar a la API (CORS), separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Réplicas de los servicios con más carga (escalado horizontal)
PRODUCT_SERVICE_REPLICAS=3
ORDER_SERVICE_REPLICAS=2

# Grafana (docker-compose.observability.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=cambia-esto
