# Lombok configuration for the whole repository.
config.stopBubbling = true

# Marks generated code with @lombok.Generated: JaCoCo excludes it from coverage.
lombok.addLombokGeneratedAnnotation = true

# @RequiredArgsConstructor copies these annotations from the field to the constructor parameter, to be able to inject
# properties (@Value) or a specific bean (@Qualifier) without writing the constructor.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
