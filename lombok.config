# Configuración de Lombok para todo el repositorio.
config.stopBubbling = true

# Marca el código generado con @lombok.Generated: JaCoCo lo excluye de la cobertura.
lombok.addLombokGeneratedAnnotation = true

# @RequiredArgsConstructor copia estas anotaciones del campo al parámetro del constructor, para poder inyectar
# propiedades (@Value) o un bean concreto (@Qualifier) sin escribir el constructor.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
